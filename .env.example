# Copy to .env. Both the web app and the worker read this file from the repo root.

# Where the database and media files live. Relative paths resolve from the repo root.
DATA_DIR=./data

# Web server (keep 127.0.0.1 so the app is only reachable from this Mac).
HOST=127.0.0.1
PORT=3000

# Worker: how many jobs of each concurrency group may run at once.
# Heavy groups (transcribe, render) stay at 1 on a 16 GB machine.
WORKER_CONCURRENCY_DEFAULT=2

# Posting (see Accounts in the app for step-by-step setup). Leave empty until you have the apps.
# YouTube: Google Cloud → OAuth client ID (Web application), redirect http://127.0.0.1:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok: developers.tiktok.com → app (Desktop platform), redirect http://127.0.0.1:3000/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional. A Twitch developer app (dev.twitch.tv/console → Register Your Application; any OAuth redirect, e.g.
# http://localhost; category "Application Integration"). Used to find the moments of a VOD that viewers clipped.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional. Account tokens are encrypted with this key (32 bytes, base64). If unset, one is created in DATA_DIR/secret.key.
# SECRET_KEY=
# Optional. Anthropic API key for the in-app "Find clips with AI" (a key saved in Settings takes precedence).
# ANTHROPIC_API_KEY=
# Optional. The address the app is reached at (OAuth redirects use it).
# APP_URL=http://127.0.0.1:3000
