{
  "name": "clipstudio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"pnpm --filter @clipstudio/web dev\" \"pnpm --filter @clipstudio/worker dev\"",
    "build": "pnpm --filter @clipstudio/web build",
    "start": "concurrently -k -n web,worker -c blue,magenta \"pnpm --filter @clipstudio/web start\" \"pnpm --filter @clipstudio/worker start\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @clipstudio/core db:generate",
    "checkup": "pnpm --filter @clipstudio/worker exec tsx src/cli/checkup.ts",
    "backup": "pnpm --filter @clipstudio/worker exec tsx src/cli/backup.ts",
    "restore": "pnpm --filter @clipstudio/worker exec tsx src/cli/restore.ts",
    "retime": "pnpm --filter @clipstudio/worker exec tsx src/cli/retime.ts",
    "test:e2e": "pnpm build && playwright test -c e2e",
    "fix:sqlite": "node scripts/fix-sqlite.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
